{
  "name": "autoprod",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "build:exe": "tsx harness/build/compile-exe.ts",
    "build:mac": "tsx harness/build/compile-mac.ts",
    "db:migrate": "tsx harness/db/migrate.ts",
    "db:status": "tsx harness/db/migrate.ts --status",
    "check:env": "tsx harness/validations/check-env.ts",
    "check:git": "tsx harness/validations/git-prep.ts",
    "deploy:prod": "tsx harness/deploy/deploy-vercel.ts",
    "deploy:vercel": "tsx harness/deploy/deploy-vercel.ts --vercel-cli",
    "test:crud": "tsx tests/folder-crud.test.ts",
    "test:proxy": "tsx tests/proxy-normalization.test.ts",
    "test:e2e": "tsx tests/e2e-openai.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/google": "^4.0.56",
    "@ai-sdk/openai": "^4.0.50",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^7.0.83",
    "dotenv": "^17.4.2",
    "next": "16.3.3",
    "pg": "^8.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]

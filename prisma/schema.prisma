generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public", "vault"]
}

model User {
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  email            String            @unique
  id               String            @id @default(uuid()) @db.Uuid
  name             String?
  role             String            @default("USER")
  geminiVaultId    String?
  openaiVaultId    String?
  anthropicVaultId String?
  apiKeys          ApiKey[]
  channels         Channel[]
  channelContexts  ChannelContext[]
  conversations    Conversation[]
  settings         UserSettings?
  subscription     UserSubscription?
  wallet           Wallet?
  paymentLedgers   PaymentLedger[]
  assets           Asset[]
  videoProjects    VideoProject[]
  intentTelemetries IntentTelemetry[]

  @@map("user")
  @@schema("public")
}

model Language {
  code      String         @id
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  name      String
  settings  UserSettings[]

  @@map("language")
  @@schema("public")
}

model UserSettings {
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  defaultResolution  String   @default("1080p")
  emailNotifications Boolean  @default(true)
  id                 String   @id @default(uuid()) @db.Uuid
  languageCode       String   @default("es")
  theme              String   @default("dark")
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
  userId             String   @unique @db.Uuid
  language           Language @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([languageCode], map: "userSettings_languageCode_idx_3f614602")
  @@map("userSettings")
  @@schema("public")
}

model ApiKey {
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  provider  String
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, provider])
  @@index([userId], map: "apiKey_userId_idx_a489d58a")
  @@map("apiKey")
  @@schema("public")
}

model UserSubscription {
  currentPeriodEnd DateTime @default(dbgenerated("(now() + '1 year'::interval)")) @db.Timestamptz(6)
  id               String   @id @default(uuid()) @db.Uuid
  planId           String   @db.Uuid
  status           String   @default("active")
  userId           String   @unique @db.Uuid
  plan             Plan     @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([planId], map: "userSubscription_planId_idx_5b32079a")
  @@map("userSubscription")
  @@schema("public")
}

model Plan {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @unique
  priceId       String?
  limits        PlanLimit?
  subscriptions UserSubscription[]

  @@map("plan")
  @@schema("public")
}

model PlanLimit {
  canRenderInCloud        Boolean @default(false)
  hasAdvancedTemplates    Boolean @default(false)
  id                      String  @id @default(uuid()) @db.Uuid
  maxChannels             Int     @default(2)
  maxMonthlyRenderMinutes Int     @default(0)
  maxVideosPerChannel     Int     @default(10)
  planId                  String  @unique @db.Uuid
  plan                    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("planLimit")
  @@schema("public")
}

model Channel {
  accessToken      String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  localPath        String?
  niche            String?
  folderStatus     String?        @default("PENDING")
  profilePicture   String?
  refreshToken     String?
  tokenExpiry      DateTime?      @db.Timestamptz(6)
  userId           String         @db.Uuid
  youtubeChannelId String?        @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversations    Conversation[]
  videos           Video[]
  videoProjects    VideoProject[]
  contentHistory   ContentHistory[]
  context          ChannelContext?
  assets           Asset[]

  @@index([userId], map: "channel_userId_idx_a489d58a")
  @@map("channel")
  @@schema("public")
}

model ChannelContext {
  id              String    @id @default(uuid()) @db.Uuid
  channelId       String    @unique @db.Uuid
  userId          String    @db.Uuid
  channelUrl      String
  handle          String?
  title           String
  description     String?
  subscriberCount Int?
  videoCount      Int?
  viewCount       BigInt?
  contextSummary  String    @db.Text
  topicsCovered   Json?     // Catálogo de títulos y temas ya tratados para anti-duplicación
  bestTags        Json?     // Ranking de mejores etiquetas ponderadas por métricas
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "channelContext_userId_idx")
  @@map("channelContext")
  @@schema("public")
}

model Asset {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  channelId   String?  @db.Uuid
  name        String
  type        String   // "IMAGE" | "THUMBNAIL" | "SUBTITLE" | "VIDEO" | "AUDIO" | "OTHER"
  format      String   // "png", "jpg", "srt", "vtt", "mp4", "mp3", etc.
  prompt      String?  @db.Text
  storageUrl  String?
  localPath   String?
  isCache     Boolean  @default(false)
  sizeBytes   BigInt   @default(0)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "asset_userId_idx")
  @@index([channelId], map: "asset_channelId_idx")
  @@index([type], map: "asset_type_idx")
  @@index([isCache], map: "asset_isCache_idx")
  @@map("asset")
  @@schema("public")
}

model VideoProject {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  channelId       String?  @db.Uuid
  title           String
  aspectRatio     String   @default("16:9")
  resolution      String   @default("1080p")
  timelineData    Json     @default("{}")
  thumbnailUrl    String?
  durationSeconds Float    @default(0)
  status          String   @default("DRAFT")
  storageMode     String   @default("LOCAL")
  localPath       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  channel         Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "videoProject_userId_idx")
  @@index([channelId], map: "videoProject_channelId_idx")
  @@map("videoProject")
  @@schema("public")
}

model ContentHistory {
  id           String    @id @default(uuid()) @db.Uuid
  channelId    String    @db.Uuid
  platform     String    @default("YOUTUBE")
  contentType  String    @default("VIDEO")
  externalId   String?
  externalUrl  String?
  title        String
  description  String?
  thumbnailUrl String?
  tags         String?
  metrics      Json?     @default("{}")
  publishedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([channelId], map: "contentHistory_channelId_idx")
  @@index([platform], map: "contentHistory_platform_idx")
  @@index([externalId], map: "contentHistory_externalId_idx")
  @@map("contentHistory")
  @@schema("public")
}

model Video {
  channelId      String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  description    String?
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  status         String         @default("DRAFT")
  tags           String?
  title          String?
  youtubeVideoId String?        @unique
  conversations  Conversation[]
  channel        Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([channelId], map: "video_channelId_idx_166d3598")
  @@map("video")
  @@schema("public")
}

model Conversation {
  channelId    String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  id           String    @id @default(uuid()) @db.Uuid
  systemPrompt String?
  title        String    @default("Nueva conversación")
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  userId       String    @db.Uuid
  videoId      String?   @db.Uuid
  channel      Channel?  @relation(fields: [channelId], references: [id], onUpdate: NoAction)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  video        Video?    @relation(fields: [videoId], references: [id], onUpdate: NoAction)
  messages     Message[]

  @@index([channelId], map: "conversation_channelId_idx_166d3598")
  @@index([userId], map: "conversation_userId_idx_a489d58a")
  @@index([videoId], map: "conversation_videoId_idx_5feac8db")
  @@map("conversation")
  @@schema("public")
}

model Message {
  conversationId String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  id             String       @id @default(uuid()) @db.Uuid
  sender         String
  text           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId], map: "message_conversationId_idx_669215a6")
  @@map("message")
  @@schema("public")
}

model PromptTemplate {
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  description  String?
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  systemPrompt String
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  welcomeText  String?

  @@map("promptTemplate")
  @@schema("public")
}

model Agent {
  id           String      @id @default(uuid())
  slug         String      @unique
  name         String
  description  String?
  systemPrompt String
  createdAt    DateTime    @default(now())
  steps        AgentStep[]
  agentTools   AgentTool[]

  @@map("agent")
  @@schema("public")
}

model AgentStep {
  id                    String      @id @default(uuid())
  agentId               String
  stepOrder             Int
  stepName              String
  apiEndpoint           String
  method                String      @default("POST")
  dynamicPromptTemplate String?
  agent                 Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agentStep")
  @@schema("public")
}

model Tool {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  schema      Json        
  apiEndpoint String      
  method      String      @default("POST")
  createdAt   DateTime    @default(now())
  agentTools  AgentTool[]

  @@map("tool")
  @@schema("public")
}

model AgentTool {
  id        String    @id @default(uuid())
  agentId   String
  toolId    String
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@map("agentTool")
  @@schema("public")
}

model ToolIntentGolden {
  id                  String                       @id @default(uuid()) @db.Uuid
  toolName            String
  domain              String                       @default("SYSTEM")
  canonicalQuery      String
  embedding           Unsupported("vector(1536)")?
  isDirectFastPath    Boolean                      @default(true)
  confidenceThreshold Float                        @default(0.85)
  metadata            Json?                        @default("{}")
  createdAt           DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([toolName, canonicalQuery], map: "uq_tool_intent_golden_canonical")
  @@index([domain], map: "idx_tool_intent_golden_domain")
  @@index([toolName], map: "idx_tool_intent_golden_tool_name")
  @@index([isDirectFastPath], map: "idx_tool_intent_golden_fast_path")
  @@map("toolIntentGolden")
  @@schema("public")
}

model IntentTelemetry {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @db.Uuid
  rawQuery        String   @db.Text
  detectedDomain  String?
  executedTool    String?
  wasFastPath     Boolean  @default(false)
  confidenceScore Float?
  success         Boolean  @default(true)
  status          String   @default("PENDING")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status], map: "idx_intent_telemetry_status")
  @@index([userId], map: "idx_intent_telemetry_user_id")
  @@index([executedTool], map: "idx_intent_telemetry_executed_tool")
  @@index([createdAt], map: "idx_intent_telemetry_created_at")
  @@map("intentTelemetry")
  @@schema("public")
}


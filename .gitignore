# ==============================================================================
# AutoProd - Git Ignore Configuration
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build & outputs
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Environment & Secrets (Ensure .env.example remains committed)
.env
.env*.local
.env.development
.env.production
.env.test
.env.motor
!.env.example

# OS & System files
.DS_Store
Thumbs.db
*.pem
*.key

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
motor.log

# Vercel deployment cache
.vercel

# Terraform (State files & Provider locks)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfvars
terraform/.temp/
.temp/

# Python & Motor Local Caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
.pytest_cache/
*.egg-info/
.autoprod/

# PyInstaller & Compilation Artifacts
build/
dist/
**/build/
**/dist/
*.toc
*.pkg

# Binaries & Executables (Avoid heavy binaries in git repository)
*.exe
*.dll
*.dylib
*.so
*.dmg
*.iso

# AI IDE & Local Workspace Cache
.claude/
.agents/
.cursor/
.devin/
.gemini/
.aider-desk/
data/
skills-lock.json
